<!--
  Fichier     : regles/ad-privilege-escalation.xml
  Objet       : détection des modifications de groupes d'administration tier (T0/T1/T2)
                et corrélation des substitutions de compte
  Source      : Windows Security via wazuh-agent (module eventchannel)
  Event ID    : 4728 / 4732 / 4756 (ajout), 4729 / 4733 / 4757 (retrait)
  MITRE       : T1531 (Account Access Removal), T1098.007 (Privileged Group Modification)
  Dépendance  : groupe natif group_changed

  Intérêt de la corrélation
    Chacune des deux opérations est légitime prise isolément. Les règles natives les
    traitent séparément et ne lèvent donc aucune alerte. La corrélation sur
    subjectUserName dans une fenêtre de 60 s est ce qui transforme deux événements
    banals en signal d'appropriation de compte.

  Limites assumées
    1. Groupe imbriqué : si un attaquant crée GRP_Projet_X, l'ajoute comme membre de
       GRP_Admins_T0 puis s'ajoute à GRP_Projet_X, le 4728 porte
       targetUserName = GRP_Projet_X. Aucune des trois règles ne matche, et
       l'escalade est effective. Détection à écrire (résolution récursive de
       l'appartenance), non couverte ici.
    2. Fenêtre temporelle : attendre 61 s entre le retrait et l'ajout suffit à
       échapper à 100406. Le seuil est un compromis assumé entre détection et
       faux positifs sur les opérations d'exploitation courantes.
    3. Périmètre de nommage : la détection repose sur une convention de nommage des
       groupes. Un groupe à privilèges hors convention n'est pas couvert.

  Environnement de test
    Laboratoire de projet annuel (Bachelor 3, ESGI Lyon), Active Directory sur
    Windows Server 2022, Wazuh <VERSION_A_CONFIRMER>. Aucune donnée client.
    Testé le 29/06/2025, scénario contrôlé : retrait puis ajout par le même
    opérateur en moins de 60 s. Résultat : alerte de niveau 14 levée,
    notification e-mail reçue avec la chronologie complète.

  Anonymisation
    Noms de groupes transposés, domaine et unités d'organisation retirés.
-->
<group name="ad_privilege_escalation,wazuh_custom,">

  <!-- 100403 : ajout privilégié à un groupe d'administration tier.
       if_group group_changed plutôt que if_sid : évite le masquage par la
       règle native de plus haute priorité sur le même événement. -->
  <rule id="100403" level="13">
    <if_group>group_changed</if_group>
    <field name="win.system.eventID" type="pcre2">^(4728|4732|4756)$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">^GRP_Admins_T[012]$</field>
    <description>[T1098.007] Ajout privilégié au groupe $(win.eventdata.targetUserName) - membre: $(win.eventdata.memberName) - par: $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1098.007</id>
    </mitre>
    <options>no_full_log</options>
  </rule>

  <!-- 100405 : retrait privilégié d'un groupe d'administration tier.
       Niveau volontairement inférieur à 100403 : un retrait seul relève plus
       souvent de l'exploitation courante que d'une action offensive. -->
  <rule id="100405" level="10">
    <if_group>group_changed</if_group>
    <field name="win.system.eventID" type="pcre2">^(4729|4733|4757)$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">^GRP_Admins_T[012]$</field>
    <description>[T1531] Retrait privilégié du groupe $(win.eventdata.targetUserName) - membre: $(win.eventdata.memberName) - par: $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1531</id>
    </mitre>
    <group>ad_account_access_removal,</group>
    <options>no_full_log</options>
  </rule>

  <!-- 100406 : substitution de compte. Règle composite.
       if_sid 100403        : la règle n'est évaluée que sur l'événement d'ajout,
                              qui devient donc l'événement déclencheur.
       if_matched_sid 100405 : exige qu'un retrait ait déjà été compté.
       frequency 2          : le compteur inclut l'événement déclencheur. Deux
                              événements corrélés = 1 retrait + 1 ajout. Valeur
                              validée au test du 29/06/2025, pas déduite de la
                              documentation.
       same_field           : subjectUserName est présent dans les deux
                              événements, la corrélation porte donc bien sur
                              l'opérateur et non sur la cible. -->
  <rule id="100406" level="14" frequency="2" timeframe="60">
    <if_sid>100403</if_sid>
    <if_matched_sid>100405</if_matched_sid>
    <same_field>win.eventdata.subjectUserName</same_field>
    <description>[CORRELATION CRITIQUE] Substitution admin: $(win.eventdata.subjectUserName) a retiré puis ajouté un membre dans un groupe admin tier en moins de 60s</description>
    <mitre>
      <id>T1531</id>
      <id>T1098.007</id>
    </mitre>
    <group>ad_account_takeover,</group>
  </rule>

</group>
